<script>
(function () {
  var root = document.getElementById('HexCrewV4-main');
  if (!root) return;

  function setStep(n) {
    root.querySelectorAll('.onb-step').forEach(function (step) {
      step.classList.toggle('active', parseInt(step.dataset.step, 10) === n);
    });
    root.querySelectorAll('.onb-content').forEach(function (panel) {
      panel.classList.toggle('active', parseInt(panel.dataset.step, 10) === n);
    });
  }

  function nextStep() {
    var active = root.querySelector('.onb-step.active');
    var current = active ? parseInt(active.dataset.step, 10) : 1;
    if (current < 5) setStep(current + 1);
  }

  window.nextStep = nextStep;
  window.goTab = goTab;

  function goTab(name) {
    var button = root.querySelector('.tab-btn[data-tab="' + name + '"]');
    var view = root.querySelector('#' + name);

    if (!button || !view) {
      name = 'recruit';
      button = root.querySelector('.tab-btn[data-tab="recruit"]');
      view = root.querySelector('#recruit');
    }

    root.querySelectorAll('.tab-btn').forEach(function (item) { item.classList.remove('active'); });
    root.querySelectorAll('.view').forEach(function (item) { item.classList.remove('active'); });

    if (button) button.classList.add('active');
    if (view) view.classList.add('active');

    try { sessionStorage.setItem('hex_crew_v4_tab', name); } catch (error) {}
    window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  }

  root.querySelectorAll('.tab-btn').forEach(function (button) {
    button.addEventListener('click', function () { goTab(button.dataset.tab); });
  });

  root.querySelectorAll('.onb-step').forEach(function (step) {
    step.addEventListener('click', function () { setStep(parseInt(step.dataset.step, 10)); });
  });

  root.querySelectorAll('.faq-q').forEach(function (question) {
    question.addEventListener('click', function () { question.parentElement.classList.toggle('open'); });
  });

  root.querySelectorAll('.tribe-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      root.querySelectorAll('.tribe-tab').forEach(function (item) { item.classList.remove('active'); });
      tab.classList.add('active');
    });
  });

  var onboardingForm = root.querySelector('#HexCrewOnboardingForm');
  if (onboardingForm) {
    onboardingForm.addEventListener('invalid', function (event) {
      var panel = event.target.closest('.onb-content');
      if (panel) setStep(parseInt(panel.dataset.step, 10));
    }, true);
  }

  try {
    var saved = sessionStorage.getItem('hex_crew_v4_tab');
    if (saved) goTab(saved);
  } catch (error) {}
  {% if crew_return_tab != blank %}
  goTab('{{ crew_return_tab }}');
  // Replace the form-post entry so a refresh reloads the portal instead of re-sending the pitch.
  try { history.replaceState(null, '', '{{ crew_path_prefix }}'); } catch (error) {}
  {% endif %}
})();
</script>
<script>
/* HEX Crew v2 landing. Reads missions, tiers and quota briefs from the other
   tabs so Matt's content has one source of truth. */
(function () {
  var root = document.getElementById('HexCrewV4-main');
  if (!root) return;
  root.classList.add('crew-js');

  var ASSET = {{ crew_asset_base | json }};
  var SERVER_TRIBE = {{ crew_tribe | json }};
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  var text = function (el, sel) {
    var node = sel ? el.querySelector(sel) : el;
    return node ? node.textContent.replace(/\s+/g, ' ').trim() : '';
  };
  var esc = function (s) {
    return String(s).replace(/[&<>"']/g, function (c) { return '&#' + c.charCodeAt(0) + ';'; });
  };
  var all = function (sel, scope) { return Array.prototype.slice.call((scope || root).querySelectorAll(sel)); };

  /* ---------- Tabs: indicator, aria-current, history, focus ---------- */
  var navInner = root.querySelector('nav.tabs .inner');
  var navIndicator = document.createElement('span');
  navIndicator.className = 'crew-tab-indicator';
  navIndicator.setAttribute('aria-hidden', 'true');
  if (navInner) navInner.appendChild(navIndicator);
  function syncNav() {
    var active = navInner && navInner.querySelector('.tab-btn.active');
    all('nav.tabs .tab-btn').forEach(function (b) {
      if (b === active) b.setAttribute('aria-current', 'page'); else b.removeAttribute('aria-current');
    });
    if (!active) { navIndicator.style.opacity = '0'; return; }
    navIndicator.style.opacity = '1';
    navIndicator.style.transform = 'translateX(' + active.offsetLeft + 'px) scaleX(' + active.offsetWidth + ')';
  }
  var baseGoTab = window.goTab;
  var tabNames = all('nav.tabs .tab-btn').map(function (b) { return b.dataset.tab; });
  function focusView(name) {
    var view = root.querySelector('#' + name);
    var heading = view && (view.querySelector('[data-view-heading]') || view.querySelector('h1, h2'));
    if (!heading) return;
    if (!heading.hasAttribute('tabindex')) heading.setAttribute('tabindex', '-1');
    heading.focus({ preventScroll: true });
  }
  if (baseGoTab) {
    window.goTab = function (name, fromHistory) {
      baseGoTab(name);
      syncNav();
      if (!fromHistory && tabNames.indexOf(name) > -1 && location.hash !== '#' + name) {
        history.pushState({ crewTab: name }, '', '#' + name);
      }
      if (!fromHistory) focusView(name);
      updateDock();
    };
    all('nav.tabs .tab-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (location.hash !== '#' + btn.dataset.tab) history.pushState({ crewTab: btn.dataset.tab }, '', '#' + btn.dataset.tab);
        requestAnimationFrame(syncNav);
        updateDock();
      });
    });
    window.addEventListener('popstate', function (event) {
      var name = (event.state && event.state.crewTab) || location.hash.slice(1) || 'recruit';
      if (tabNames.indexOf(name) > -1) window.goTab(name, true);
    });
    var fromHash = location.hash.slice(1);
    if (tabNames.indexOf(fromHash) > -1) window.goTab(fromHash, true);
  }
  root.addEventListener('click', function (event) {
    var target = event.target.closest('[data-go]');
    if (target && window.goTab) window.goTab(target.getAttribute('data-go'));
  });
  window.addEventListener('resize', syncNav);
  if ('ResizeObserver' in window) {
    var navSizes = new ResizeObserver(syncNav);
    all('nav.tabs .tab-btn').forEach(function (b) { navSizes.observe(b); });
  }
  syncNav();

  /* ---------- Scroll reveals ---------- */
  var revealables = all('[data-reveal]');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); }
      });
    }, { rootMargin: '0px 0px 10% 0px', threshold: 0 });
    revealables.forEach(function (el) { io.observe(el); });
  } else {
    revealables.forEach(function (el) { el.classList.add('is-in'); });
  }

  /* ---------- Phone apply bar ---------- */
  var dock = root.querySelector('[data-dock]');
  var heroVisible = true, finalVisible = false;
  function updateDock() {
    if (!dock) return;
    var onLanding = !!root.querySelector('#recruit.active');
    var on = onLanding && !heroVisible && !finalVisible;
    dock.classList.toggle('is-on', on);
    dock.setAttribute('aria-hidden', on ? 'false' : 'true');
    dock.querySelector('button').tabIndex = on ? 0 : -1;
  }
  if (dock && 'IntersectionObserver' in window) {
    var hero = root.querySelector('[data-hero]');
    var finalCta = root.querySelector('[data-final]');
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.target === hero) heroVisible = e.isIntersecting;
        if (e.target === finalCta) finalVisible = e.isIntersecting;
      });
      updateDock();
    }, { threshold: 0 }).observe(hero);
    if (finalCta) new IntersectionObserver(function (entries) {
      finalVisible = entries[0].isIntersecting; updateDock();
    }, { threshold: 0 }).observe(finalCta);
  }

  /* ---------- Tribe picker ---------- */
  var tablist = root.querySelector('[data-tribe-tabs]');
  if (tablist) {
    var tabs = all('[role="tab"]', tablist);
    var indicator = tablist.querySelector('.crew-tribe-indicator');
    var panel = root.querySelector('#crew-tribe-panel');
    var meta = root.querySelector('[data-tribe-meta]');
    var list = root.querySelector('[data-tribe-missions]');
    var missions = all('#bonuses .mission').map(function (m) {
      return {
        type: text(m, '.mission-type'), tribe: text(m, '.mission-tribe'), title: text(m, 'h3'),
        brief: text(m, '.brief'), pay: text(m, '.pay'), clock: text(m, '.clock')
      };
    });
    var swapTimer;

    function placeIndicator(tab) {
      indicator.style.transform = 'translateX(' + tab.offsetLeft + 'px) scaleX(' + tab.offsetWidth + ')';
    }
    function markOverflow() {
      tablist.toggleAttribute('data-more', tablist.scrollLeft + tablist.clientWidth < tablist.scrollWidth - 4);
    }
    function fillPanel(tab) {
      var word = tab.dataset.name;
      meta.querySelector('[data-tribe-scope]').textContent = tab.dataset.scope;
      meta.querySelector('[data-tribe-name]').textContent = word;
      var own = missions.filter(function (m) { return new RegExp('\\b' + word + '\\b', 'i').test(m.tribe); });
      var open = missions.filter(function (m) { return /all tribes|any tribe/i.test(m.tribe); });
      list.innerHTML = own.length ? own.slice(0, 3).map(function (m) {
        return '<li class="crew-mission"><span class="crew-mission-type">' + esc(m.type) + '</span>' +
          '<h3 class="crew-mission-title">' + esc(m.title) + '</h3>' +
          '<span class="crew-mission-clock">' + esc(m.clock) + '</span>' +
          '<p class="crew-mission-brief">' + esc(m.brief) + '</p>' +
          '<p class="crew-mission-pay">' + esc(m.pay) + '</p></li>';
      }).join('') : '<li class="crew-missions-empty">No ' + esc(word) + '-only missions this round. The open missions still count for your tribe.</li>';
      var more = meta.querySelector('[data-tribe-more]');
      more.hidden = !open.length;
      more.textContent = open.length ? 'Plus ' + open.length + ' missions open to every tribe.' : '';
    }
    function select(tab, opts) {
      opts = opts || {};
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      panel.setAttribute('aria-labelledby', tab.id);
      placeIndicator(tab);
      if (tab.offsetLeft < tablist.scrollLeft || tab.offsetLeft + tab.offsetWidth > tablist.scrollLeft + tablist.clientWidth) {
        tablist.scrollTo({ left: tab.offsetLeft - 16, behavior: reduceMotion.matches || opts.instant ? 'auto' : 'smooth' });
      }
      if (opts.focus) tab.focus();
      if (opts.remember) { try { localStorage.setItem('hex_crew_tribe', tab.dataset.tribe); } catch (e) {} }
      clearTimeout(swapTimer);
      // Keyboard and first paint switch instantly; a click gets a short crossfade.
      if (opts.instant || reduceMotion.matches) { fillPanel(tab); return; }
      [meta, list].forEach(function (el) { el.classList.add('is-swapping'); });
      swapTimer = setTimeout(function () {
        fillPanel(tab);
        requestAnimationFrame(function () { [meta, list].forEach(function (el) { el.classList.remove('is-swapping'); }); });
      }, 140);
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () { select(tab, { remember: true }); });
      tab.addEventListener('keydown', function (event) {
        var next = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[event.key];
        if (next === undefined) return;
        event.preventDefault();
        select(tabs[(next + tabs.length) % tabs.length], { remember: true, focus: true, instant: true });
      });
    });
    tablist.addEventListener('scroll', markOverflow, { passive: true });

    var saved = null;
    try { saved = localStorage.getItem('hex_crew_tribe'); } catch (e) {}
    var initial = tabs.filter(function (t) { return t.dataset.tribe === (SERVER_TRIBE || saved); })[0] || tabs[0];
    select(initial, { instant: true });
    markOverflow();
    var reposition = function () {
      var current = tablist.querySelector('[aria-selected="true"]');
      if (current) placeIndicator(current);
      markOverflow();
    };
    window.addEventListener('resize', reposition);
    // Web fonts load without blocking, so re-measure when a tab's width changes.
    if ('ResizeObserver' in window) {
      var tribeSizes = new ResizeObserver(reposition);
      tabs.forEach(function (t) { tribeSizes.observe(t); });
    }
  }

  /* ---------- Tier ladder (one equal band per tier) ---------- */
  var range = root.querySelector('[data-range]');
  var tiers = all('#tiers .tier-card').map(function (card) {
    var vals = card.querySelectorAll('.tier-stack-val');
    var label = text(card, '.tier-threshold');
    var money = label.match(/\$([\d,]+)/);
    return {
      name: text(card, '.tier-name'), label: label, at: money ? Number(money[1].replace(/,/g, '')) : 0,
      comm: vals[0] ? text(vals[0]) : '', aud: vals[1] ? text(vals[1]) : '',
      perks: all('.tier-perks li', card).map(function (li) { return text(li); })
    };
  });
  if (range && tiers.length) {
    var band = Number(range.max) / tiers.length;
    var top = tiers[tiers.length - 1].at * 1.5;
    var out = root.querySelector('[data-range-out]');
    var rungs = root.querySelector('[data-rungs]');
    var nameEl = root.querySelector('[data-tier-name]');
    var atEl = root.querySelector('[data-tier-at]');
    var commEl = root.querySelector('[data-tier-comm]');
    var audEl = root.querySelector('[data-tier-aud]');
    var perksEl = root.querySelector('[data-tier-perks]');
    var current = -1;
    rungs.innerHTML = tiers.map(function (t) {
      return '<li class="crew-rung"><b>' + esc(t.name) + '</b><span>' + esc(t.at ? '$' + t.at.toLocaleString('en-AU') : 'Day one') + '</span></li>';
    }).join('');
    var rungEls = rungs.querySelectorAll('.crew-rung');
    var money = function (n) { return '$' + n.toLocaleString('en-AU'); };
    var pulse = function (el) {
      if (reduceMotion.matches || !el.animate) return;
      el.animate([{ transform: 'translateY(30%)', opacity: 0 }, { transform: 'none', opacity: 1 }],
        { duration: 220, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
    };
    function toDollars(pos) {
      var idx = Math.min(tiers.length - 1, Math.floor(pos / band));
      var lo = tiers[idx].at, hi = idx < tiers.length - 1 ? tiers[idx + 1].at : top;
      var raw = lo + ((pos - idx * band) / band) * (hi - lo);
      var step = raw < 2000 ? 100 : raw < 10000 ? 250 : 1000;
      return { idx: idx, dollars: Math.round(raw / step) * step };
    }
    function update() {
      var r = toDollars(Number(range.value));
      out.textContent = money(r.dollars);
      range.style.setProperty('--fill', (Number(range.value) / Number(range.max)) * 100 + '%');
      range.setAttribute('aria-valuetext', money(r.dollars) + ', ' + tiers[r.idx].name + ' tier');
      rungEls.forEach(function (el, i) { el.classList.toggle('is-reached', i <= r.idx); });
      if (r.idx === current) return;
      current = r.idx;
      var t = tiers[r.idx];
      nameEl.textContent = t.name; atEl.textContent = t.label; commEl.textContent = t.comm; audEl.textContent = t.aud;
      perksEl.innerHTML = t.perks.map(function (p, i) { return '<li class="is-new" style="--i:' + i + '">' + esc(p) + '</li>'; }).join('');
      [nameEl, commEl, audEl].forEach(pulse);
    }
    range.addEventListener('input', update);
    update();
  }

  /* ---------- Clip deck ---------- */
  var deck = root.querySelector('[data-deck]');
  if (deck) {
    var cards = all('#quota .uc-card');
    deck.innerHTML = cards.map(function (card, i) {
      var num = String(i + 1).padStart(2, '0');
      var title = text(card, 'h3');
      var meta = all('.uc-meta span', card).map(function (s) {
        var key = text(s, 'strong');
        return '<span><b>' + esc(key) + '</b> ' + esc(text(s).replace(key, '').trim()) + '</span>';
      }).join('');
      var photo = /consuming hex/i.test(title)
        ? '<span class="crew-clip-photo"><img src="' + ASSET + '/sachet-500.webp" srcset="' + ASSET + '/sachet-500.webp 500w, ' + ASSET + '/sachet-900.webp 900w" sizes="320px" alt="" loading="lazy" decoding="async"></span>'
        : '';
      return '<div class="crew-clip' + (photo ? ' has-photo' : '') + '" role="listitem">' +
        '<div class="crew-clip-inner">' +
          '<div class="crew-clip-face crew-clip-front">' + photo +
            '<span class="crew-clip-num" aria-hidden="true">' + num + '</span>' +
            '<span class="crew-clip-cat" aria-hidden="true">' + esc(text(card, '.uc-pill')) + '</span>' +
            '<span class="crew-clip-title" aria-hidden="true">' + esc(title) + '</span>' +
            '<span class="crew-clip-hint" aria-hidden="true">Tap for the brief</span>' +
            '<button type="button" class="crew-clip-front-btn" aria-expanded="false" aria-controls="crew-clip-' + num + '" aria-label="Clip ' + (i + 1) + ': ' + esc(title) + '. Show the brief"></button>' +
          '</div>' +
          '<div class="crew-clip-face crew-clip-back" id="crew-clip-' + num + '" inert>' +
            '<p>' + esc(text(card, 'p')) + '</p><span class="crew-clip-meta">' + meta + '</span>' +
            '<button type="button" class="crew-link" data-clip-back>Back to card</button>' +
          '</div>' +
        '</div></div>';
    }).join('');
    function flip(clip, open) {
      clip.classList.toggle('is-flipped', open);
      var front = clip.querySelector('.crew-clip-front'), back = clip.querySelector('.crew-clip-back');
      var btn = clip.querySelector('.crew-clip-front-btn');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      front.inert = open; back.inert = !open;
      (open ? back.querySelector('[data-clip-back]') : btn).focus({ preventScroll: true });
    }
    deck.addEventListener('click', function (event) {
      var clip = event.target.closest('.crew-clip');
      if (!clip) return;
      if (event.target.closest('.crew-clip-front-btn')) flip(clip, true);
      else if (event.target.closest('[data-clip-back]')) flip(clip, false);
    });

    var nav = root.querySelector('[data-deck-nav]');
    var prev = root.querySelector('[data-deck-prev]');
    var next = root.querySelector('[data-deck-next]');
    var count = root.querySelector('[data-deck-count]');
    var clips = all('.crew-clip', deck);
    function stepWidth() { return clips[1] ? clips[1].offsetLeft - clips[0].offsetLeft : deck.clientWidth; }
    function updateDeckNav() {
      var w = stepWidth();
      var first = Math.round(deck.scrollLeft / w);
      var visible = Math.max(1, Math.floor((deck.clientWidth - 2 * clips[0].offsetLeft + 16) / w));
      var last = Math.min(clips.length, first + visible);
      count.textContent = (first + 1) + '–' + last + ' of ' + clips.length;
      prev.disabled = deck.scrollLeft <= 4;
      next.disabled = deck.scrollLeft + deck.clientWidth >= deck.scrollWidth - 4;
    }
    var scrollBy = function (dir) {
      deck.scrollBy({ left: dir * stepWidth(), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };
    if (nav && clips.length) {
      nav.hidden = false;
      prev.addEventListener('click', function () { scrollBy(-1); });
      next.addEventListener('click', function () { scrollBy(1); });
      deck.addEventListener('scroll', function () { window.requestAnimationFrame(updateDeckNav); }, { passive: true });
      window.addEventListener('resize', updateDeckNav);
      updateDeckNav();
    }
  }
  updateDock();
})();
</script>
