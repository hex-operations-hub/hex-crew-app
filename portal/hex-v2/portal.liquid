      <span class="brand-meta">Crew</span>
    </div>
    <div class="hex-v4-header-actions">
      {% if customer %}
        <a class="url-bar" href="{{ routes.account_url }}">My account</a>
      {% else %}
        <a class="url-bar" href="{{ routes.account_login_url }}">Sign in</a>
      {% endif %}
      <a class="url-bar" href="https://hexenergy.goaffpro.com/login" target="_blank" rel="noopener">Affiliate login</a>
    </div>
  </div>
</header>

<nav class="tabs">
  <div class="inner">
    <button class="tab-btn active" data-tab="recruit">The Crew</button>
    <button class="tab-btn" data-tab="tiers">Tiers &amp; Earnings</button>
    <button class="tab-btn" data-tab="quota">Monthly Quota</button>
    <button class="tab-btn" data-tab="bonuses">Missions &amp; Prizes</button>
{% if customer %}
    <button class="tab-btn" data-tab="pitches">Pitches &amp; Collabs</button>
{% if crew_leaderboard != 'hide' %}
    <button class="tab-btn" data-tab="leaderboard">Leaderboard</button>
{% endif %}
{% if crew_creator_view != 'hide' %}
    <button class="tab-btn" data-tab="dashboard">Creator View</button>
{% endif %}
{% endif %}
    <button class="tab-btn" data-tab="onboarding">Onboarding</button>
  </div>
