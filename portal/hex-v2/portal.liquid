          <li>Discord (HEX HQ)</li>
        </ul>
      </div>
      <div class="tier-card">
        <div class="tier-pill o"><span class="dot"></span> Tier 02</div>
        <div class="tier-name">Operator</div>
        <div class="tier-threshold">$2,000 referred · 90d</div>
        <div class="tier-stack">
          <div class="tier-stack-row">
            <span class="tier-stack-label">Your commission</span>
            <span class="tier-stack-val">20<small>%</small></span>
          </div>
          <div class="tier-stack-row">
            <span class="tier-stack-label">Audience saves</span>
            <span class="tier-stack-val" style="color:var(--blue);">20<small>%</small></span>
          </div>
        </div>
        <ul class="tier-perks">
          <li>Free product monthly</li>
          <li>Spike-tier missions</li>
          <li>Mystery Box draws</li>
          <li>Co-branded merch kit</li>
        </ul>
      </div>
      <div class="tier-card featured">
        <div class="tier-pill c"><span class="dot"></span> Tier 03</div>
        <div class="tier-name">Catalyst</div>
        <div class="tier-threshold">$10,000 referred · 90d</div>
        <div class="tier-stack">
          <div class="tier-stack-row">
            <span class="tier-stack-label">Your commission</span>
            <span class="tier-stack-val" style="color:var(--gold);">25<small>%</small></span>
          </div>
          <div class="tier-stack-row">
            <span class="tier-stack-label">Audience saves</span>
            <span class="tier-stack-val" style="color:var(--gold);">25<small>%</small></span>
