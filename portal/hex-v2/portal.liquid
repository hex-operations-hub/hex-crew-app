{% if customer %}
<!-- ===================== 5. PITCHES & COLLABS ===================== -->
<section class="view" id="pitches">
  <div class="shell">
    <span class="eyebrow">Pitch board</span>
    <h2 class="display">Got an idea?<br/>Type it in. Get paid if we ship it.</h2>
    <p class="lede">Every creator can pitch a mission, an activation, a flavour, or a collab target. The community votes weekly. When a pitch rises to the top and we ship it, the creator who proposed it gets paid. From $500 for a sharp mission idea to $5k+ for a collab that lands.</p>

    <div class="card" style="padding:36px;background:var(--surface-2);margin:24px 0 32px;border:2px dashed var(--border-strong);">
      <form method="post" action="{{ crew_path_prefix }}/pitch" id="HexCrewPitchForm" accept-charset="UTF-8">
        <input type="hidden" name="crew_token" value="{{ crew_form_token }}">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;flex-wrap:wrap;gap:14px;">
          <div>
            <div style="font-size:11px;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">Submit a pitch</div>
            <div style="font-size:18px;font-weight:700;letter-spacing:-0.4px;">{{ customer.name | default: customer.email | escape }}</div>
          </div>
          <div style="font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;font-size:11px;color:var(--mute);">Native Shopify submission</div>
        </div>
        {% if crew_pitch_status == 'sent' %}
          <div class="callout" role="status" style="margin-bottom:18px;"><strong>Pitch received.</strong> HEX will review it and get back to you.</div>
        {% elsif crew_pitch_status == 'error' %}
          <div class="callout" role="alert" style="margin-bottom:18px;"><strong>That didn't send.</strong> {{ crew_pitch_error }}</div>
        {% endif %}
        <div class="form-row">
          <label for="HexCrewPitchEmail">Email</label>
          <input id="HexCrewPitchEmail" type="email" value="{{ customer.email | escape }}" readonly>
        </div>
        <div class="form-grid-2">
          <div class="form-row"><label for="HexCrewPitchCategory">Category</label><input id="HexCrewPitchCategory" type="text" name="pitch[category]" maxlength="100" placeholder="Mission · Activation · Collab" required></div>
          <div class="form-row"><label for="HexCrewPitchValue">Suggested value</label><input id="HexCrewPitchValue" type="text" name="pitch[value]" maxlength="50" placeholder="$500"></div>
        </div>
        <div class="form-row"><label for="HexCrewPitchTitle">Title</label><input id="HexCrewPitchTitle" type="text" name="pitch[title]" maxlength="200" placeholder="Give the idea a sharp name" required></div>
        <div class="form-row"><label for="HexCrewPitchBody">The pitch</label><textarea id="HexCrewPitchBody" rows="4" name="pitch[body]" maxlength="5000" placeholder="What happens, where it happens and why HEX should back it." required></textarea></div>
        <div style="display:flex;justify-content:space-between;align-items:center;margin-top:8px;gap:18px;flex-wrap:wrap;">
