<!-- ===================== 9. ONBOARDING ===================== -->
<section class="view" id="onboarding">
  <div class="shell">
    <span class="eyebrow">Intake</span>
    <h2 class="display">Welcome to HEX Crew.</h2>
    <p class="lede">Five clips become your athlete card. Complete the fields, add one shared Drive, Dropbox or WeTransfer link, then send the intake directly to HEX through Shopify.</p>

    <!-- LIVE ACCOUNT + CONTENT LINK + AFFILIATE ACCESS -->
    <div class="card-grid-3" style="margin-bottom:40px;">
      <div class="card" style="background:var(--ink);color:#fff;border-color:var(--ink);">
        <div style="font-size:11px;color:var(--gold);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;">01 · Shopify account</div>
        <h4 style="margin-top:0;color:#fff;font-size:17px;">Customer sign in</h4>
        <p style="font-size:13px;color:#9a978d;margin:8px 0 14px;line-height:1.6;">Shopify sends a one-time code to your email. Orders and customer details stay inside the store account structure.</p>
        <a class="btn" href="{{ routes.account_login_url }}" style="background:#fff;color:var(--ink);">Open Shopify sign in</a>
      </div>
      <div class="card" style="background:var(--surface);border-color:var(--border);">
        <div style="font-size:11px;color:var(--blue);font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;">02 · Your content link</div>
        <h4 style="margin-top:0;font-size:17px;">One shared folder or transfer link</h4>
        <p style="font-size:13px;color:var(--mute);margin:8px 0 14px;line-height:1.6;">Upload your five clips to Drive, Dropbox or WeTransfer, set access so HEX can view it, then paste the link in the final step.</p>
        <div style="font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;font-size:11px;color:var(--mute);background:var(--surface-2);padding:8px 12px;border-radius:6px;border:1px solid var(--border);">https://drive.google.com/...</div>
      </div>
      <div class="card" style="background:var(--gold);color:var(--ink);border-color:var(--gold);">
        <div style="font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;margin-bottom:10px;opacity:0.8;">03 · Affiliate access</div>
        <h4 style="margin-top:0;font-size:17px;">GoAffPro portal</h4>
        <p style="font-size:13px;margin:8px 0 14px;line-height:1.6;">Affiliate applications, referral links and tracked commissions use the separate HEX GoAffPro portal.</p>
        <a class="btn" href="https://hexenergy.goaffpro.com/create-account" target="_blank" rel="noopener" style="background:var(--ink);color:#fff;">Open affiliate application</a>
      </div>
    </div>

    <div class="callout" style="margin-top:0;margin-bottom:40px;padding:32px;">
      <h3 style="font-size:24px;margin-bottom:8px;">Live your life. Record here and there. Shoot it through.</h3>
      <p style="font-size:15px;">You're not making content for HEX — you're filming what you already do, dropping it in your folder, and letting the system match it to missions and prizes. The 10-clip quota is a minimum because volume + variety wins the algorithm. Past that: keep going if you want, stop if life gets in the way. The platform doesn't punish you for being human.</p>
    </div>

    {% form 'contact', id: 'HexCrewOnboardingForm' %}
      <input type="hidden" name="contact[Program]" value="HEX Crew onboarding">
      {% if form.posted_successfully? %}
        <div class="callout" role="status" style="margin-bottom:24px;"><strong>Application received.</strong> HEX will review the intake from the store contact inbox. Affiliate access remains in GoAffPro.</div>
      {% endif %}
      {{ form.errors | default_errors }}

    <div class="onb-stepper">
      <div class="onb-step active" data-step="1"><div class="step-n">Clip 01</div><div class="step-name">Athlete intro</div></div>
      <div class="onb-step" data-step="2"><div class="step-n">Clip 02</div><div class="step-name">Mid-workout</div></div>
      <div class="onb-step" data-step="3"><div class="step-n">Clip 03</div><div class="step-name">The sachet crack</div></div>
      <div class="onb-step" data-step="4"><div class="step-n">Clip 04</div><div class="step-name">What you train for</div></div>
      <div class="onb-step" data-step="5"><div class="step-n">Clip 05</div><div class="step-name">Favourite quote</div></div>
    </div>

    <div class="onb-content active" data-step="1">
      <h3>Clip 01 — Athlete intro</h3>
      <p class="lede">This is the card the rest of HEX Crew sees when you join. Treat it like a UFC walk-in tape, an AFL highlight reel, a surfer's bio reel.</p>
      <div class="clip-spec">
        <div class="clip-tag"><span class="name">Clip 01</span><span class="duration">15–30 sec · vertical</span></div>
        <h4>What we want</h4>
        <p class="what">Look down the barrel. Say your name, what tribe you rep, where you train, and one line about what makes you different. Confident, not performed.</p>
        <h5>Beats, in order</h5>
        <ul>
          <li><strong>0–2s hook:</strong> action shot — running, lifting, sparring, decks, paddling out</li>
          <li><strong>2–8s:</strong> face to camera — "I'm [name], [tribe], training out of [gym / club / spot]"</li>
          <li><strong>8–18s:</strong> the differentiator — "I'm building toward [goal]"</li>
          <li><strong>18–25s:</strong> close on a frame that holds — silhouette, sunrise, the sachet</li>
        </ul>
        <div class="pro-tip"><strong>Pro tip.</strong> Filmed at your training spot at first light. Cott pier, Trigg point, the F45 carpark before class. Locals immediately know you're real.</div>
      </div>
      <div class="form-row"><label for="HexCrewName">Name (as you want it shown)</label><input id="HexCrewName" type="text" name="contact[name]" value="{{ customer.name | escape }}" placeholder="e.g. Tahlia Skye" autocomplete="name" required></div>
      <div class="form-row"><label for="HexCrewEmail">Email</label><input id="HexCrewEmail" type="email" name="contact[email]" value="{{ customer.email | escape }}" placeholder="you@example.com" autocomplete="email" required></div>
      <div class="form-grid-2">
        <div class="form-row"><label for="HexCrewTribe">Tribe</label><input id="HexCrewTribe" type="text" name="contact[Tribe]" placeholder="Trail · Lift · Combat · Night · Grind" required></div>
        <div class="form-row"><label for="HexCrewTraining">Where you train</label><input id="HexCrewTraining" type="text" name="contact[Training location]" placeholder="Cottesloe · Scrappy MMA · F45 Mt Lawley" required></div>
      </div>
      <button type="button" class="btn btn-primary" onclick="nextStep()">Next — Clip 02 <span class="arrow">→</span></button>
    </div>

    <div class="onb-content" data-step="2">
      <h3>Clip 02 — Mid-workout</h3>
      <p class="lede">The grit shot. We need to see you in the work — sweating, breathing, mid-rep, mid-round, mid-set, mid-paddle. Effort over polish.</p>
      <div class="clip-spec">
        <div class="clip-tag"><span class="name">Clip 02</span><span class="duration">10–20 sec · vertical</span></div>
        <h4>What we want</h4>
        <p class="what">A single take. Camera locked off or moving with you. No filters, no slow-mo. Sound on — we want the breathing.</p>
        <h5>Acceptable formats by tribe</h5>
        <ul>
          <li><strong>Lift —</strong> last three reps of a heavy set. The grind ones.</li>
          <li><strong>Trail —</strong> last 200m of a track rep, duck-diving a set, or 1km out from shore on an ocean swim.</li>
          <li><strong>Combat —</strong> a round of pads or sparring. Face shown when you reset.</li>
          <li><strong>Night —</strong> mid-set behind the decks, sweat visible, crowd in shot if possible.</li>
          <li><strong>Grind —</strong> on-site shot. Scaffolding, FIFO mess hall, kitchen pass.</li>
        </ul>
        <div class="pro-tip"><strong>Pro tip.</strong> Mount your phone on a tripod 1–2m back. The most-watched HEX clips had the phone too close — you could feel the breath.</div>
      </div>
      <button type="button" class="btn btn-primary" onclick="nextStep()">Next — Clip 03 <span class="arrow">→</span></button>
    </div>

    <div class="onb-content" data-step="3">
      <h3>Clip 03 — The sachet crack</h3>
      <p class="lede">The signature HEX moment. Every brand needs an action that becomes shorthand for the brand — for HEX, it's the sachet open and pour.</p>
      <div class="clip-spec">
        <div class="clip-tag"><span class="name">Clip 03</span><span class="duration">5–10 sec · vertical</span></div>
        <h4>What we want</h4>
        <p class="what">Vertical. Sachet in your hands. Tear it open clean. Pour into your bottle, shaker or glass. Crisp audio — the rip, the pour. Sachet readable on screen for at least 1.5 seconds.</p>
        <h5>The HEX choreography</h5>
        <ul>
          <li><strong>0–2s.</strong> Sachet in frame — held up, label readable</li>
          <li><strong>2–5s.</strong> Rip — clean, single motion, audio crisp</li>
          <li><strong>5–8s.</strong> Pour — bottle, shaker, or glass</li>
          <li><strong>8–10s.</strong> Close — cap on, shake, ready to go</li>
        </ul>
        <div class="pro-tip"><strong>Pro tip.</strong> The sachet is the hero. Clean backdrop — gym wall, dawn beach, kitchen bench. The best of these become paid ads with attribution + $50 license fee per use.</div>
      </div>
      <button type="button" class="btn btn-primary" onclick="nextStep()">Next — Clip 04 <span class="arrow">→</span></button>
    </div>

    <div class="onb-content" data-step="4">
      <h3>Clip 04 — What you train for</h3>
      <p class="lede">The "why." This separates a creator who lasts from a creator who churns. Show us the goal. The thing in the distance.</p>
      <div class="clip-spec">
        <div class="clip-tag"><span class="name">Clip 04</span><span class="duration">20–40 sec · vertical</span></div>
        <h4>What we want</h4>
        <p class="what">Look down the barrel. Tell us the goal — the race, the fight, the championship, the line you want to surf. Be specific.</p>
        <h5>Good examples</h5>
        <ul>
          <li><em>"Training for the 2027 Rottnest Channel Swim. Solo. Sub-7 hours."</em></li>
          <li><em>"I want a 6-minute mile by December. I'm at 6:42 today."</em></li>
          <li><em>"First amateur MMA bout in 14 weeks. 70kg division."</em></li>
        </ul>
        <h5>Avoid</h5>
        <ul class="bad">
          <li>"Just want to be the best version of myself" — too vague</li>
          <li>Generic "consistency is everything" — won't land</li>
        </ul>
        <div class="pro-tip"><strong>Pro tip.</strong> Specificity is the algorithm's friend. A real date + a real number + a real venue beats general motivation every time.</div>
      </div>
      <button type="button" class="btn btn-primary" onclick="nextStep()">Next — Clip 05 <span class="arrow">→</span></button>
    </div>

    <div class="onb-content" data-step="5">
      <h3>Clip 05 — Favourite quote</h3>
      <p class="lede">The closer. The line you live by. We pin it on your athlete card and re-use it in your launch graphic.</p>
      <div class="clip-spec">
        <div class="clip-tag"><span class="name">Clip 05</span><span class="duration">10–20 sec · vertical</span></div>
        <h4>What we want</h4>
        <p class="what">Phone close, dead-on. Say the quote slowly. Then say who said it — or "me." One take.</p>
        <h5>What lands</h5>
        <ul>
          <li>Quotes that don't sound like quotes — things people actually say</li>
          <li>From your coach, your old man, a teammate, a song lyric</li>
        </ul>
        <h5>What doesn't land</h5>
        <ul class="bad">
          <li>Anything off a gym wall poster</li>
          <li>"Pain is temporary, glory is forever"</li>
          <li>Anything Marcus Aurelius (every fitness creator opens with him)</li>
        </ul>
        <div class="pro-tip"><strong>Pro tip.</strong> The best are local and specific. "The Doctor always shows up." "Pull yourself off the line." "If you can hear the crowd, you're not in deep enough."</div>
      </div>
      <div class="form-row"><label for="HexCrewQuote">The quote</label><textarea id="HexCrewQuote" rows="2" name="contact[Quote]" placeholder="e.g. The Doctor always shows up."></textarea></div>
      <div class="form-row"><label for="HexCrewQuoteSource">Who said it</label><input id="HexCrewQuoteSource" type="text" name="contact[Quote source]" placeholder="My coach · My nan · Me · A song"></div>
      <div class="form-row"><label for="HexCrewContentLink">Photo or video folder link</label><input id="HexCrewContentLink" type="url" name="contact[Content link]" placeholder="Shared Drive, Dropbox or WeTransfer link" required><div style="font-size:12px;color:var(--mute);margin-top:6px;">Set link access so HEX can view the files.</div></div>
      <button class="btn btn-primary" type="submit">Submit my athlete card <span class="arrow">→</span></button>
    </div>
    {% endform %}
  </div>
</section>

<footer>
  <strong>HEX Crew</strong> · by HEX Energy · Perth, WA
</footer>

</div>

<script>
(function () {
  var root = document.getElementById('HexCrewV4-main');
  if (!root) return;

  function setStep(n) {
    root.querySelectorAll('.onb-step').forEach(function (step) {
      step.classList.toggle('active', parseInt(step.dataset.step, 10) === n);
    });
    root.querySelectorAll('.onb-content').forEach(function (panel) {
      panel.classList.toggle('active', parseInt(panel.dataset.step, 10) === n);
    });
  }

  function nextStep() {
    var active = root.querySelector('.onb-step.active');
    var current = active ? parseInt(active.dataset.step, 10) : 1;
    if (current < 5) setStep(current + 1);
  }

  window.nextStep = nextStep;
  window.goTab = goTab;

  function goTab(name) {
    var button = root.querySelector('.tab-btn[data-tab="' + name + '"]');
    var view = root.querySelector('#' + name);

    if (!button || !view) {
      name = 'recruit';
      button = root.querySelector('.tab-btn[data-tab="recruit"]');
      view = root.querySelector('#recruit');
    }

    root.querySelectorAll('.tab-btn').forEach(function (item) { item.classList.remove('active'); });
    root.querySelectorAll('.view').forEach(function (item) { item.classList.remove('active'); });

    if (button) button.classList.add('active');
    if (view) view.classList.add('active');

    try { localStorage.setItem('hex_crew_v4_tab', name); } catch (error) {}
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  root.querySelectorAll('.tab-btn').forEach(function (button) {
    button.addEventListener('click', function () { goTab(button.dataset.tab); });
  });

  root.querySelectorAll('.onb-step').forEach(function (step) {
    step.addEventListener('click', function () { setStep(parseInt(step.dataset.step, 10)); });
  });

  root.querySelectorAll('.faq-q').forEach(function (question) {
    question.addEventListener('click', function () { question.parentElement.classList.toggle('open'); });
  });

  root.querySelectorAll('.tribe-tab').forEach(function (tab) {
    tab.addEventListener('click', function () {
      root.querySelectorAll('.tribe-tab').forEach(function (item) { item.classList.remove('active'); });
      tab.classList.add('active');
    });
  });

  var onboardingForm = root.querySelector('#HexCrewOnboardingForm');
  if (onboardingForm) {
    onboardingForm.addEventListener('invalid', function (event) {
      var panel = event.target.closest('.onb-content');
      if (panel) setStep(parseInt(panel.dataset.step, 10));
    }, true);
  }

  try {
    var saved = localStorage.getItem('hex_crew_v4_tab');
    if (saved) goTab(saved);
  } catch (error) {}
})();
</script>
