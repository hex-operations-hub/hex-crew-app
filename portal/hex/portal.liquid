<style>
:root {
  color-scheme: light;
  --bg: #f5f4ee;
  --bg-grid: #ebeae3;
  --surface: #ffffff;
  --surface-2: #faf9f4;
  --ink: #0a0a0a;
  --ink-2: #1f1f1f;
  --mute: #6a6a6a;
  --mute-2: #9a978d;
  --border: #e8e6dd;
  --border-strong: #d4d2c7;
  --gold: #b88f2a;
  --gold-soft: #f4ecd4;
  --blue: #2a6dc4;
  --orange: #c4742a;
  --green: #3a8a55;
  --terracotta: #b4543a;
  --crimson: #a02d3c;
}
* { box-sizing: border-box; }
html, body {
  margin: 0; padding: 0;
  background: var(--bg);
  color: var(--ink);
  background-image:
    linear-gradient(var(--bg-grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--bg-grid) 1px, transparent 1px);
  background-size: 64px 64px;
  background-position: -1px -1px;
}
body {
  font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 15px;
  line-height: 1.55;
  letter-spacing: -0.005em;
  -webkit-font-smoothing: antialiased;
}
.shell { max-width: 1200px; margin: 0 auto; padding: 0 32px; }

/* ============ HEADER ============ */
header.hx-header {
  background: rgba(245,244,238,0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 100;
}
.hx-header-inner {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 32px; max-width: 1200px; margin: 0 auto;
}
.brand { display: flex; align-items: center; gap: 12px; font-weight: 700; font-size: 18px; letter-spacing: -0.4px; }
.brand .mark { width: 24px; height: 24px; background: var(--ink); clip-path: polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0% 50%); }
.brand-meta { font-size: 12px; color: var(--mute); font-weight: 400; }
.url-bar {
  font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
  font-size: 12px; color: var(--mute);
  background: var(--surface); padding: 7px 12px;
  border-radius: 8px; border: 1px solid var(--border);
}
.url-bar .gold { color: var(--gold); font-weight: 600; }

/* ============ TABS ============ */
nav.tabs {
  background: rgba(245,244,238,0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
  position: sticky; top: 65px; z-index: 90;
  overflow-x: auto;
}
nav.tabs .inner { display: flex; max-width: 1200px; margin: 0 auto; padding: 0 32px; }
nav.tabs button {
  background: transparent; border: 0;
  color: var(--mute); font-weight: 500; font-size: 13px;
  padding: 16px 0; margin-right: 28px;
  cursor: pointer; border-bottom: 2px solid transparent;
  transition: all 0.15s; white-space: nowrap; font-family: inherit;
}
nav.tabs button:hover { color: var(--ink); }
nav.tabs button.active { color: var(--ink); border-bottom-color: var(--gold); }

/* ============ SECTIONS ============ */
section.view { display: none; padding: 72px 0 96px; }
section.view.active { display: block; }

.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 13px; font-weight: 500; color: var(--gold);
  text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 24px;
}
.eyebrow::before { content: ""; width: 8px; height: 8px; background: var(--gold); border-radius: 50%; }
.eyebrow.blue { color: var(--blue); } .eyebrow.blue::before { background: var(--blue); }
.eyebrow.green { color: var(--green); } .eyebrow.green::before { background: var(--green); }
.eyebrow.orange { color: var(--orange); } .eyebrow.orange::before { background: var(--orange); }
.eyebrow.terracotta { color: var(--terracotta); } .eyebrow.terracotta::before { background: var(--terracotta); }
.eyebrow.crimson { color: var(--crimson); } .eyebrow.crimson::before { background: var(--crimson); }

h1.display { font-size: 76px; font-weight: 700; letter-spacing: -3px; line-height: 0.95; margin: 0 0 28px; max-width: 880px; }
h2.display { font-size: 54px; font-weight: 700; letter-spacing: -2px; line-height: 0.98; margin: 0 0 20px; }
h3 { font-size: 22px; font-weight: 600; letter-spacing: -0.6px; margin: 32px 0 12px; }
h4 { font-size: 13px; font-weight: 600; color: var(--mute); margin: 28px 0 12px; }
.lede { font-size: 18px; color: var(--mute); max-width: 680px; line-height: 1.55; margin-bottom: 56px; }

/* ============ BUTTONS ============ */
.btn {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 14px 22px; border-radius: 12px;
  font-weight: 600; font-size: 14px; border: 0; cursor: pointer;
  transition: all 0.15s; font-family: inherit;
}
.btn-primary { background: var(--ink); color: #fff; }
.btn-primary:hover { transform: translateY(-1px); }
.btn-ghost { background: transparent; color: var(--ink); border: 1px solid var(--border-strong); }
.btn-ghost:hover { background: var(--surface); }
.btn .arrow { font-size: 16px; }

/* ============ STAT GRIDS ============ */
.stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-top: 64px; }
.stat-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
.stat-card .stat-label { font-size: 13px; color: var(--mute); margin-bottom: 16px; }
.stat-card .stat-n { font-size: 52px; font-weight: 700; letter-spacing: -2.3px; line-height: 1; }
.stat-card .stat-n small { font-size: 16px; font-weight: 500; color: var(--mute); margin-left: 2px; }
.stat-card .stat-foot { font-size: 13px; color: var(--mute); margin-top: 12px; line-height: 1.5; }

/* ============ TIER + ECON TABLE ============ */
.tier-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin: 40px 0; }
.tier-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; position: relative; transition: all 0.2s; }
.tier-card:hover { transform: translateY(-2px); border-color: var(--border-strong); }
.tier-card.featured { background: var(--ink); color: #fff; border-color: var(--ink); }
.tier-card.featured .tier-threshold, .tier-card.featured .tier-commission small, .tier-card.featured .tier-detail { color: #9a978d; }
.tier-card.featured .tier-perks { border-top-color: #2a2a2a; }
.tier-card.featured::before { content: "Most chased"; position: absolute; top: 20px; right: 20px; background: var(--gold); color: var(--ink); font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 100px; }
.tier-pill { display: inline-flex; align-items: center; gap: 8px; font-size: 12px; color: var(--mute); padding: 4px 10px; background: var(--bg); border: 1px solid var(--border); border-radius: 100px; margin-bottom: 20px; font-weight: 500; }
.tier-card.featured .tier-pill { background: rgba(255,255,255,0.06); border-color: rgba(255,255,255,0.12); color: #c8c5b8; }
.tier-pill .dot { width: 6px; height: 6px; border-radius: 50%; }
.tier-pill.r .dot { background: var(--mute); }
.tier-pill.o .dot { background: var(--blue); }
.tier-pill.c .dot { background: var(--gold); }
.tier-pill.x .dot { background: var(--terracotta); }
.tier-name { font-size: 22px; font-weight: 700; letter-spacing: -0.6px; }
.tier-threshold { font-size: 12px; color: var(--mute); margin: 4px 0 24px; }
.tier-stack { display: grid; gap: 12px; margin-bottom: 24px; }
.tier-stack-row { display: flex; justify-content: space-between; align-items: baseline; padding: 12px 0; border-bottom: 1px dashed var(--border); }
.tier-card.featured .tier-stack-row { border-bottom-color: #2a2a2a; }
.tier-stack-row:last-child { border-bottom: 0; }
.tier-stack-label { font-size: 12px; color: var(--mute); }
.tier-card.featured .tier-stack-label { color: #9a978d; }
.tier-stack-val { font-size: 28px; font-weight: 700; letter-spacing: -1.2px; }
.tier-perks { list-style: none; padding: 20px 0 0; margin: 0; border-top: 1px solid var(--border); font-size: 13px; }
.tier-perks li { padding: 5px 0; }
.tier-commission { font-size: 48px; font-weight: 700; letter-spacing: -2px; line-height: 1; }
.tier-commission small { font-size: 14px; font-weight: 500; color: var(--mute); margin-left: 2px; }

/* ============ ECON CALCULATOR ============ */
.econ-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 40px; margin: 32px 0; }
.econ-row {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr 1.2fr 1fr;
  gap: 12px; padding: 16px 0;
  align-items: center;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}
.econ-row:last-child { border-bottom: 0; }
.econ-row.head { font-size: 11px; color: var(--mute); text-transform: uppercase; letter-spacing: 0.05em; padding-bottom: 16px; }
.econ-row .tname { font-weight: 600; }
.econ-row .neg { color: var(--crimson); }
.econ-row .pos { color: var(--green); font-weight: 700; }
.econ-row .big { font-weight: 700; font-size: 16px; }

/* ============ CARDS / GRIDS ============ */
.card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; }
.card-grid-3 { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
.card-grid-2 { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; }

/* ============ QUOTA / USE CASES ============ */
.uc-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 16px; margin: 32px 0; }
.uc-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; position: relative; transition: all 0.2s; }
.uc-card:hover { transform: translateY(-2px); border-color: var(--border-strong); }
.uc-num {
  position: absolute; top: 24px; right: 24px;
  font-family: "JetBrains Mono", ui-monospace, Menlo, monospace;
  font-size: 13px; color: var(--mute); font-weight: 500;
}
.uc-pill { display: inline-flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 600; color: var(--gold); padding: 4px 10px; background: var(--gold-soft); border-radius: 100px; margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.04em; }
.uc-card h3 { font-size: 22px; margin: 0 0 10px; font-weight: 700; letter-spacing: -0.6px; }
.uc-card p { font-size: 14px; color: var(--mute); margin: 0 0 16px; line-height: 1.6; }
.uc-meta { display: flex; gap: 16px; font-size: 12px; color: var(--mute); padding-top: 16px; border-top: 1px dashed var(--border); }
.uc-meta strong { color: var(--ink); font-weight: 600; }

/* ============ MISSIONS (kept) ============ */
.mission-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(330px,1fr)); gap: 16px; }
.mission { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; transition: all 0.2s; cursor: pointer; }
.mission:hover { transform: translateY(-2px); border-color: var(--border-strong); }
.mission-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.mission-type { font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; color: var(--mute); }
.mission-type .dot { width: 8px; height: 8px; border-radius: 50%; }
.mission-type.pulse .dot { background: var(--mute); }
.mission-type.spike .dot { background: var(--blue); }
.mission-type.surge .dot { background: var(--gold); }
.mission-type.squad .dot { background: var(--terracotta); }
.mission-tribe { font-size: 12px; color: var(--mute); }
.mission h3 { margin: 4px 0 12px; font-size: 22px; font-weight: 600; letter-spacing: -0.6px; }
.mission .brief { font-size: 14px; color: var(--mute); margin-bottom: 24px; line-height: 1.6; }
.mission-payout { display: flex; justify-content: space-between; align-items: center; padding-top: 20px; border-top: 1px solid var(--border); font-size: 13px; }
.mission-payout .pay { font-weight: 600; color: var(--ink); }
.mission-payout .clock { color: var(--mute); }

/* ============ SPARK + WILDCARDS ============ */
.spark-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin: 32px 0; }
.spark-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 32px; position: relative; }
.spark-card.podium-1 { background: var(--ink); color: #fff; border-color: var(--ink); }
.spark-card.podium-1 .spark-rank { color: var(--gold); }
.spark-card.podium-1 .spark-prize { color: var(--gold); }
.spark-card.podium-1 .spark-foot { color: #9a978d; }
.spark-rank { font-size: 12px; font-weight: 600; color: var(--mute); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; }
.spark-prize { font-size: 56px; font-weight: 700; letter-spacing: -2.5px; line-height: 1; }
.spark-prize small { font-size: 16px; font-weight: 500; color: var(--mute); }
.spark-foot { font-size: 13px; color: var(--mute); margin-top: 12px; line-height: 1.6; }

.wildcard-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 14px; margin: 32px 0; }
.wildcard { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 24px; transition: all 0.2s; position: relative; overflow: hidden; }
.wildcard:hover { transform: translateY(-2px); border-color: var(--gold); }
.wildcard::before { content: ""; position: absolute; top: 0; right: 0; width: 60px; height: 60px; background: var(--gold-soft); border-radius: 0 0 0 60px; opacity: 0.7; }
.wildcard-cadence { font-size: 11px; font-weight: 600; color: var(--gold); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 10px; position: relative; }
.wildcard h4 { font-size: 17px; font-weight: 700; letter-spacing: -0.4px; color: var(--ink); margin: 0 0 8px; }
.wildcard p { font-size: 13px; color: var(--mute); margin: 0 0 12px; line-height: 1.5; }
.wildcard-val { font-size: 22px; font-weight: 700; letter-spacing: -0.8px; }
.wildcard-val small { font-size: 11px; font-weight: 500; color: var(--mute); margin-left: 2px; text-transform: uppercase; letter-spacing: 0.05em; }

/* ============ 3-MONTH MAP ============ */
.map-month { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 40px; margin-bottom: 16px; position: relative; overflow: hidden; }
.map-month::before { content: ""; position: absolute; top: 0; left: 0; width: 6px; height: 100%; background: var(--gold); }
.map-month.m1::before { background: var(--blue); }
.map-month.m2::before { background: var(--gold); }
.map-month.m3::before { background: var(--terracotta); }
.map-head { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
.map-month-n { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 13px; color: var(--mute); margin-bottom: 4px; }
.map-month-name { font-size: 38px; font-weight: 700; letter-spacing: -1.4px; line-height: 1; }
.map-target { text-align: right; }
.map-target-n { font-size: 38px; font-weight: 700; letter-spacing: -1.4px; line-height: 1; }
.map-target-label { font-size: 12px; color: var(--mute); margin-top: 4px; }
.map-content { display: grid; grid-template-columns: 1.4fr 1fr; gap: 24px; }
.map-prizes h4 { margin-top: 0; }
.map-prize-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px dashed var(--border); font-size: 14px; }
.map-prize-row:last-child { border-bottom: 0; }
.map-prize-row .qty { color: var(--mute); font-size: 13px; }
.map-prize-row .v { font-weight: 600; }
.map-econ { background: var(--surface-2); border-radius: 14px; padding: 24px; }
.map-econ-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px dashed var(--border-strong); font-size: 14px; }
.map-econ-row:last-child { border-bottom: 0; padding-top: 14px; }
.map-econ-row.net { font-weight: 700; color: var(--green); }
.map-econ-label { color: var(--mute); }
.map-new {
  display: inline-block; background: var(--gold); color: var(--ink);
  font-size: 11px; font-weight: 700; padding: 3px 8px;
  border-radius: 4px; margin-right: 6px; letter-spacing: 0.04em;
}

/* ============ TRIBES ============ */
.tribe-row { display: grid; grid-template-columns: repeat(5,1fr); gap: 12px; margin: 24px 0; }
.tribe-card { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; transition: all 0.15s; cursor: pointer; }
.tribe-card:hover { transform: translateY(-2px); border-color: var(--border-strong); }
.tribe-icon { width: 32px; height: 32px; background: var(--ink); clip-path: polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0% 50%); margin-bottom: 16px; }
.tribe-name { font-weight: 600; font-size: 17px; letter-spacing: -0.4px; }
.tribe-count { color: var(--mute); font-size: 12px; margin-top: 2px; }

/* ============ LEADERBOARD ============ */
.tribe-tabs { display: flex; gap: 8px; margin: 32px 0; flex-wrap: wrap; }
.tribe-tab { background: var(--surface); border: 1px solid var(--border); border-radius: 100px; padding: 8px 16px; font-size: 13px; font-weight: 500; cursor: pointer; transition: all 0.15s; color: var(--mute); }
.tribe-tab:hover { color: var(--ink); }
.tribe-tab.active { background: var(--ink); color: #fff; border-color: var(--ink); }
.leaderboard { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; overflow: hidden; }
.lb-row { display: grid; grid-template-columns: 64px 1fr 90px 110px 110px 130px; align-items: center; padding: 18px 28px; border-bottom: 1px solid var(--border); font-size: 14px; }
.lb-row:last-child { border-bottom: 0; }
.lb-row.head { background: var(--surface-2); font-size: 12px; color: var(--mute); }
.lb-row .rank { font-weight: 600; color: var(--mute); }
.lb-row.r1 .rank, .lb-row.r2 .rank, .lb-row.r3 .rank { color: var(--ink); font-weight: 700; }
.lb-row .rank-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
.lb-row.r1 .rank-dot { background: var(--gold); }
.lb-row.r2 .rank-dot { background: var(--mute); }
.lb-row.r3 .rank-dot { background: var(--terracotta); }
.lb-creator { display: flex; align-items: center; gap: 14px; }
.lb-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--bg); border: 1px solid var(--border); font-weight: 600; font-size: 14px; display: flex; align-items: center; justify-content: center; }
.lb-name { font-weight: 600; }
.lb-handle { color: var(--mute); font-size: 12px; margin-top: 2px; }
.lb-num { font-weight: 600; }
.lb-views { color: var(--mute); }
.lb-earned { font-weight: 700; font-size: 16px; }
.lb-clips { color: var(--mute); font-size: 13px; }
.lb-clips strong { color: var(--ink); }

/* ============ CREATOR DASHBOARD ============ */
.dash-grid { display: grid; grid-template-columns: 280px 1fr; gap: 20px; }
.dash-sidebar { background: var(--ink); color: #fff; border-radius: 20px; padding: 32px; height: fit-content; }
.dash-avatar { width: 72px; height: 72px; background: var(--gold); clip-path: polygon(25% 0,75% 0,100% 50%,75% 100%,25% 100%,0% 50%); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 22px; color: var(--ink); margin-bottom: 18px; }
.dash-name { font-size: 20px; font-weight: 700; letter-spacing: -0.5px; }
.dash-handle { font-size: 13px; color: #9a978d; margin-top: 4px; }
.dash-tier { display: inline-flex; align-items: center; gap: 6px; background: var(--gold); color: var(--ink); font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 100px; margin-top: 14px; }
.dash-nav { margin-top: 32px; list-style: none; padding: 0; }
.dash-nav li { padding: 12px 0; font-size: 14px; color: #9a978d; cursor: pointer; border-bottom: 1px solid #1f1f1f; }
.dash-nav li.act { color: var(--gold); font-weight: 600; }
.next-tier-note { margin-top: 28px; padding-top: 20px; border-top: 1px solid #1f1f1f; font-size: 13px; color: #9a978d; line-height: 1.6; }
.next-tier-note strong { color: var(--gold); display: block; margin-bottom: 4px; }
.dash-main { display: grid; gap: 16px; }
.dash-kpis { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
.dash-kpi { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px; }
.dash-kpi .kpi-l { font-size: 13px; color: var(--mute); margin-bottom: 12px; }
.dash-kpi .kpi-n { font-size: 36px; font-weight: 700; letter-spacing: -1.4px; line-height: 1; }
.dash-kpi .kpi-d { font-size: 12px; color: var(--green); margin-top: 8px; font-weight: 500; }
.dash-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
.dash-card h3 { margin: 0 0 20px; font-size: 18px; }
.payout-row { display: grid; grid-template-columns: 1fr 120px 100px 110px; padding: 14px 0; border-bottom: 1px solid var(--border); font-size: 14px; align-items: center; }
.payout-row:last-child { border-bottom: 0; }
.payout-row .src { font-weight: 600; }
.payout-row .meta { color: var(--mute); font-size: 12px; margin-top: 2px; }
.payout-row .amt { font-weight: 700; text-align: right; }
.status-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; }
.status-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; }
.status-pill.paid::before { background: var(--green); } .status-pill.paid { color: var(--green); }
.status-pill.pending::before { background: var(--orange); } .status-pill.pending { color: var(--orange); }
.status-pill.locked::before { background: var(--terracotta); } .status-pill.locked { color: var(--terracotta); }

/* ============ QUOTA TRACKER ============ */
.quota-tracker { background: var(--surface-2); border-radius: 12px; padding: 20px; margin-top: 14px; }
.quota-bar { display: grid; grid-template-columns: repeat(10,1fr); gap: 4px; height: 32px; margin: 14px 0 8px; }
.quota-pill { background: var(--border); border-radius: 4px; position: relative; }
.quota-pill.done { background: var(--green); }
.quota-pill.done::after { content: "✓"; position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: #fff; font-size: 14px; font-weight: 700; }
.quota-pill.extra { background: var(--gold); }
.quota-foot { display: flex; justify-content: space-between; font-size: 12px; color: var(--mute); }

/* ============ ADMIN DASHBOARD ============ */
.admin-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px; flex-wrap: wrap; gap: 16px; }
.admin-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; padding: 6px 12px; border-radius: 100px; background: var(--surface); border: 1px solid var(--border); color: var(--mute); }
.admin-pill .dot { width: 8px; height: 8px; background: var(--green); border-radius: 50%; }
.admin-kpis { display: grid; grid-template-columns: repeat(6,1fr); gap: 12px; margin-bottom: 24px; }
.admin-kpi { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 20px; }
.admin-kpi .l { font-size: 11px; color: var(--mute); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.04em; }
.admin-kpi .n { font-size: 26px; font-weight: 700; letter-spacing: -0.9px; line-height: 1; }
.admin-kpi .n small { font-size: 13px; font-weight: 500; color: var(--mute); }
.admin-kpi .d { font-size: 11px; color: var(--green); margin-top: 6px; font-weight: 500; }
.admin-kpi .d.warn { color: var(--orange); }
.admin-kpi .d.bad { color: var(--crimson); }

.chart-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; margin-bottom: 16px; }
.chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; }
.chart-card h3 { margin: 0 0 6px; font-size: 18px; font-weight: 600; letter-spacing: -0.4px; }
.chart-card .sub { font-size: 13px; color: var(--mute); margin-bottom: 24px; }
.chart-wrap { position: relative; height: 280px; }

.attrib-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }

.risk-row { display: grid; grid-template-columns: 1fr 100px 80px 80px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--border); font-size: 14px; }
.risk-row:last-child { border-bottom: 0; }
.risk-row .label { font-weight: 600; }
.risk-row .meta { color: var(--mute); font-size: 12px; margin-top: 2px; }
.risk-bar { width: 100px; height: 8px; background: var(--border); border-radius: 100px; overflow: hidden; }
.risk-bar-fill { height: 100%; background: var(--green); border-radius: 100px; }
.risk-bar-fill.warn { background: var(--orange); }
.risk-bar-fill.bad { background: var(--crimson); }
.risk-val { font-weight: 700; text-align: right; }

/* ============ ONBOARDING ============ */
.onb-stepper { display: grid; grid-template-columns: repeat(5,1fr); gap: 8px; margin: 40px 0 32px; }
.onb-step { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px; cursor: pointer; transition: all 0.15s; }
.onb-step:hover { border-color: var(--border-strong); }
.onb-step.active { border-color: var(--ink); background: var(--ink); color: #fff; }
.onb-step.active .step-n { color: var(--gold); }
.onb-step .step-n { font-size: 12px; font-weight: 600; color: var(--mute); }
.onb-step .step-name { font-weight: 600; font-size: 15px; margin-top: 8px; letter-spacing: -0.3px; }
.onb-content { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 48px; display: none; }
.onb-content.active { display: block; }
.onb-content h3 { font-size: 32px; font-weight: 700; letter-spacing: -1.1px; margin: 0 0 12px; }
.onb-content .lede { font-size: 16px; max-width: 720px; margin-bottom: 36px; }

.clip-spec { background: var(--surface-2); border-radius: 16px; padding: 32px; margin: 16px 0; border: 1px solid var(--border); }
.clip-tag { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 16px; }
.clip-tag .name { font-size: 13px; font-weight: 600; color: var(--gold); }
.clip-tag .duration { font-family: "JetBrains Mono", ui-monospace, Menlo, monospace; font-size: 12px; color: var(--mute); background: var(--surface); border: 1px solid var(--border); padding: 2px 10px; border-radius: 6px; }
.clip-spec h4 { font-size: 20px; font-weight: 600; margin: 0 0 8px; color: var(--ink); letter-spacing: -0.4px; }
.clip-spec .what { font-size: 15px; color: var(--mute); margin-bottom: 20px; line-height: 1.6; }
.clip-spec h5 { font-size: 12px; font-weight: 600; color: var(--mute); margin: 16px 0 8px; letter-spacing: 0.02em; text-transform: uppercase; }
.clip-spec ul { margin: 0; padding-left: 20px; font-size: 14px; color: var(--ink-2); }
.clip-spec ul li { margin-bottom: 8px; line-height: 1.6; }
.clip-spec .pro-tip { margin-top: 20px; background: var(--gold-soft); border-radius: 12px; padding: 16px 20px; font-size: 14px; color: var(--ink-2); line-height: 1.6; }
.clip-spec .pro-tip strong { color: var(--gold); }
.clip-spec ul.bad li { color: var(--terracotta); }

.form-row { margin: 16px 0; }
.form-row label { display: block; font-size: 13px; font-weight: 500; color: var(--mute); margin-bottom: 8px; }
.form-row input, .form-row textarea { width: 100%; padding: 14px 16px; border: 1px solid var(--border-strong); border-radius: 10px; font-family: inherit; font-size: 14px; background: var(--surface); }
.form-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }

/* ============ CALLOUT ============ */
.callout { background: var(--ink); color: #fff; border-radius: 20px; padding: 48px; margin: 40px 0; }
.callout h3 { font-size: 32px; font-weight: 700; letter-spacing: -1px; margin: 0 0 16px; color: #fff; }
.callout p { font-size: 16px; color: #c8c5b8; max-width: 640px; line-height: 1.6; margin: 0; }
.callout ul { list-style: none; padding: 0; margin: 16px 0 0; }
.callout ul li { padding: 8px 0; color: #c8c5b8; font-size: 15px; line-height: 1.6; }
.callout ul li strong { color: var(--gold); font-weight: 600; }

/* ============ FAQ ============ */
.faq { background: var(--surface); border: 1px solid var(--border); border-radius: 14px; margin-bottom: 10px; overflow: hidden; }
.faq-q { padding: 22px 28px; font-weight: 600; font-size: 16px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; letter-spacing: -0.3px; }
.faq-q::after { content: "+"; color: var(--mute); font-size: 20px; }
.faq.open .faq-q::after { content: "−"; }
.faq-a { display: none; padding: 0 28px 24px; color: var(--mute); font-size: 14px; line-height: 1.6; }
.faq.open .faq-a { display: block; }

/* ============ LESSONS ============ */
.lesson-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(310px,1fr)); gap: 16px; }
.lesson { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: 28px; transition: all 0.15s; }
.lesson .lab-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--bg); border: 1px solid var(--border); font-size: 12px; color: var(--mute); padding: 4px 10px; border-radius: 100px; margin-bottom: 20px; font-weight: 500; }
.lesson .lab-pill .dot { width: 6px; height: 6px; border-radius: 50%; }
.lesson.win .lab-pill .dot { background: var(--green); }
.lesson.warn .lab-pill .dot { background: var(--terracotta); }
.lesson .brand-n { font-size: 22px; font-weight: 700; letter-spacing: -0.6px; margin-bottom: 8px; }
.lesson .stat-n { font-size: 44px; font-weight: 700; letter-spacing: -1.8px; line-height: 1; margin: 12px 0; }
.lesson .stat-n small { font-size: 13px; font-weight: 500; color: var(--mute); }
.lesson .verdict { font-size: 13px; font-weight: 600; margin-bottom: 16px; }
.lesson.win .verdict { color: var(--green); }
.lesson.warn .verdict { color: var(--terracotta); }
.lesson p { font-size: 14px; color: var(--mute); margin: 0 0 16px; line-height: 1.6; }
.lesson .takeaway { background: var(--surface-2); border: 1px solid var(--border); padding: 14px 16px; border-radius: 10px; font-size: 13px; line-height: 1.5; }
.lesson .takeaway strong { color: var(--ink); display: block; margin-bottom: 2px; font-weight: 600; }

footer { border-top: 1px solid var(--border); background: var(--surface); padding: 32px; font-size: 13px; text-align: center; color: var(--mute); line-height: 1.6; }
footer strong { color: var(--ink); font-weight: 600; }

@media (max-width: 880px) {
  h1.display { font-size: 44px; letter-spacing: -1.4px; }
  h2.display { font-size: 32px; letter-spacing: -1px; }
  .stats-grid, .tribe-row, .tier-grid, .uc-grid { grid-template-columns: 1fr 1fr; }
  .dash-grid { grid-template-columns: 1fr; }
  .dash-kpis, .admin-kpis { grid-template-columns: 1fr 1fr; }
  .onb-stepper { grid-template-columns: repeat(2,1fr); }
  .onb-content { padding: 24px; }
  .map-content { grid-template-columns: 1fr; }
  .chart-grid, .attrib-grid { grid-template-columns: 1fr; }
  .spark-grid { grid-template-columns: 1fr; }
  .wildcard-grid { grid-template-columns: 1fr 1fr; }
}

.brand-logo-exact { display:block; width:88px; height:auto; object-fit:contain; flex:0 0 auto; }
