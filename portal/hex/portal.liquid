    <div class="card" style="padding:36px;background:var(--surface-2);margin:24px 0 32px;border:2px dashed var(--border-strong);">
      {% form 'contact', id: 'HexCrewPitchForm' %}
        <input type="hidden" name="contact[Program]" value="HEX Crew pitch">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;flex-wrap:wrap;gap:14px;">
          <div>
            <div style="font-size:11px;font-weight:600;color:var(--gold);text-transform:uppercase;letter-spacing:0.05em;margin-bottom:6px;">Submit a pitch</div>
            <div style="font-size:18px;font-weight:700;letter-spacing:-0.4px;">{{ customer.name | default: customer.email | escape }}</div>
          </div>
          <div style="font-family:'JetBrains Mono',ui-monospace,Menlo,monospace;font-size:11px;color:var(--mute);">Native Shopify submission</div>
        </div>
        {% if form.posted_successfully? %}
          <div class="callout" role="status" style="margin-bottom:18px;"><strong>Pitch received.</strong> HEX will review it from the store contact inbox.</div>
        {% endif %}
        {{ form.errors | default_errors }}
        <div class="form-row">
          <label for="HexCrewPitchEmail">Email</label>
          <input id="HexCrewPitchEmail" type="email" name="contact[email]" value="{{ customer.email | escape }}" readonly required>
        </div>
        <div class="form-grid-2">
          <div class="form-row"><label for="HexCrewPitchCategory">Category</label><input id="HexCrewPitchCategory" type="text" name="contact[Pitch category]" placeholder="Mission · Activation · Collab" required></div>
          <div class="form-row"><label for="HexCrewPitchValue">Suggested value</label><input id="HexCrewPitchValue" type="text" name="contact[Suggested value]" placeholder="$500"></div>
